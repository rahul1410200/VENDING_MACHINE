`timescale 1ns / 1ps

module vending_machine_tb;

reg clk;
reg reset;
reg nickel, dime, quarter;


wire item;
wire [7:0] change;

vending_machine dut (
    .clk(clk),
    .reset(reset),
    .nickel(nickel),
    .dime(dime),
    .quarter(quarter),
    .item(item),
    .change(change)
);


always #5 clk = ~clk;

initial begin
    clk = 0;
    reset = 1;
    nickel = 0;
    dime = 0;
    quarter = 0;

    #10;
    reset = 0;

    @(posedge clk) quarter = 1; 
    @(posedge clk) quarter = 0; 
    @(posedge clk) quarter = 1;
    @(posedge clk) quarter = 0; 
    
    @(posedge clk) #1; 
    #10; 

    
    @(posedge clk) dime = 1;
    @(posedge clk) dime = 0;
    @(posedge clk) dime = 1;
    @(posedge clk) dime = 0;
    @(posedge clk) nickel = 1;
    @(posedge clk) nickel = 0;
    @(posedge clk) nickel = 1;
    @(posedge clk) nickel = 0;
    @(posedge clk) nickel = 1;
    @(posedge clk) nickel = 0;

    #10;

    @(posedge clk) dime = 1;
    @(posedge clk) dime = 0;
    @(posedge clk) quarter = 1;
    @(posedge clk) quarter = 0;
    @(posedge clk) quarter = 1;
    @(posedge clk) quarter = 0;
    @(posedge clk) quarter = 1;
    @(posedge clk) quarter = 0;

    @(posedge clk) #1;
    
    #20;
    $finish; 
end

endmodule
